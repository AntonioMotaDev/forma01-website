# Copia este archivo a .env.local para desarrollo y agrega las mismas
# variables en Vercel → Project → Settings → Environment Variables.

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://forma01.net

# WhatsApp en formato internacional sin "+" ni espacios (México móvil: 521 + 10 dígitos).
# Déjalo vacío para ocultar el botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# SMTP para el formulario de contacto (ejemplo con Gmail + contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=dev.antoniomota@gmail.com
SMTP_PASS=

# A dónde llegan los mensajes y desde qué dirección se envían
CONTACT_TO_EMAIL=dev.antoniomota@gmail.com
CONTACT_FROM_EMAIL=dev.antoniomota@gmail.com
