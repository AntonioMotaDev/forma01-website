# Headers de Cloudflare para los archivos estáticos.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Next exporta las imágenes Open Graph sin extensión; sin esto se servirían
# sin Content-Type y las redes sociales no las mostrarían.
/opengraph-image
  Content-Type: image/png

/proyectos/*/opengraph-image
  Content-Type: image/png
