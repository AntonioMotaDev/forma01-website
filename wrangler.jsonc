{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forma01-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // Sitio estático generado por `next build` (output: "export").
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Solo /api/* ejecuta el Worker; el resto se sirve como archivo estático
    // (no cuenta contra el límite de peticiones del plan gratis).
    "run_worker_first": ["/api/*"],
  },

  // 3 envíos por minuto por IP en cada ubicación de Cloudflare.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],

  // Variables públicas. El secreto RESEND_API_KEY se define aparte:
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    "CONTACT_TO_EMAIL": "dev.antoniomota@gmail.com",
    // Remitente con el dominio verificado en Resend. Si algún día el dominio
    // deja de estar verificado, Resend rechazará los envíos; el remitente de
    // prueba es "FORMA/01 <onboarding@resend.dev>".
    "CONTACT_FROM_EMAIL": "FORMA/01 <contacto@forma01.net>",
  },

  "observability": { "enabled": true },
}
